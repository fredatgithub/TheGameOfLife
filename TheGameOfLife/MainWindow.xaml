<Window x:Class="TheGameOfLife.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TheGameOfLife"
        Title="Le Jeu de la vie selon Fred" Height="650" Width="1000"
        MinHeight="480" MinWidth="700"
        Background="#101820"
        Foreground="#E8F0F2">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Le Jeu de la vie" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Un automate cellulaire imaginé par John Conway en 1970"
                           Margin="0,4,0,0" Foreground="#9FB2B8" FontSize="14" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Charger" Click="LoadButton_Click" Padding="16,9"
                        Margin="0,0,8,0" />
                <Button Content="Enregistrer" Click="SaveButton_Click" Padding="16,9" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="1" Background="#263940" CornerRadius="8">
            <local:LifeBoard x:Name="Board" />
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PlayButton" Content="Démarrer" Click="PlayButton_Click"
                        Padding="16,9" Margin="0,0,8,0" />
                <Button Content="Avancer" Click="StepButton_Click" Padding="16,9"
                        Margin="0,0,8,0" />
                <Button Content="Aléatoire" Click="RandomButton_Click" Padding="16,9"
                        Margin="0,0,8,0" />
                <Button Content="Effacer" Click="ClearButton_Click" Padding="16,9" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatsText" VerticalAlignment="Center" Margin="0,0,18,0"
                           FontSize="14" />
                <TextBlock Text="Vitesse" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="#9FB2B8" />
                <Slider x:Name="SpeedSlider" Width="110" Minimum="1" Maximum="20"
                        Value="5" TickFrequency="1" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="SpeedText" Width="48" VerticalAlignment="Center"
                           Margin="8,0,0,0" Foreground="#9FB2B8" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
